{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversation_summary": { "type": "string" },
        "customer_intent": { "type": "string" },
        "primary_issue": { "type": "string" },
        "call_outcome": { "type": "string" }
      },
      "required": ["conversation_summary", "customer_intent", "primary_issue", "call_outcome"]
    },
    "overall_sentiment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "enum": ["positive", "neutral", "negative"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "breakdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "positive": { "type": "number", "minimum": 0, "maximum": 100 },
            "neutral": { "type": "number", "minimum": 0, "maximum": 100 },
            "negative": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "required": ["positive", "neutral", "negative"]
        }
      },
      "required": ["label", "confidence", "breakdown"]
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer" },
          "speaker": { "type": "string", "enum": ["customer", "agent", "other"] },
          "sentence": { "type": "string" },
          "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
          "emotion": { "type": "string", "enum": ["anger", "frustration", "disappointment", "anxiety", "neutral", "satisfaction", "relief", "gratitude"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reasoning": { "type": "string" }
        },
        "required": ["id", "speaker", "sentence", "sentiment", "emotion", "confidence", "reasoning"]
      }
    },
    "kpis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customer_satisfaction": {
          "type": "object", "additionalProperties": false,
          "properties": { "score": { "type": "number", "minimum": 0, "maximum": 100 }, "level": { "type": "string", "enum": ["low", "medium", "high"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "reasoning": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } },
          "required": ["score", "level", "confidence", "reasoning", "evidence"]
        },
        "escalation_risk": {
          "type": "object", "additionalProperties": false,
          "properties": { "score": { "type": "number", "minimum": 0, "maximum": 100 }, "level": { "type": "string", "enum": ["low", "medium", "high"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "reasoning": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } },
          "required": ["score", "level", "confidence", "reasoning", "evidence"]
        },
        "resolution_status": {
          "type": "object", "additionalProperties": false,
          "properties": { "status": { "type": "string", "enum": ["resolved", "partially_resolved", "unresolved", "follow_up_required", "unknown"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "reasoning": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } },
          "required": ["status", "confidence", "reasoning", "evidence"]
        },
        "agent_empathy": {
          "type": "object", "additionalProperties": false,
          "properties": { "score": { "type": "number", "minimum": 0, "maximum": 100 }, "level": { "type": "string", "enum": ["low", "medium", "high"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "reasoning": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } },
          "required": ["score", "level", "confidence", "reasoning", "evidence"]
        },
        "business_impact": {
          "type": "object", "additionalProperties": false,
          "properties": { "level": { "type": "string", "enum": ["none", "low", "medium", "high", "critical"] }, "categories": { "type": "array", "items": { "type": "string", "enum": ["revenue", "operations", "sla", "churn", "reputation", "compliance", "none"] } }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "reasoning": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } },
          "required": ["level", "categories", "confidence", "reasoning", "evidence"]
        },
        "repeat_contact": {
          "type": "object", "additionalProperties": false,
          "properties": { "score": { "type": "number", "minimum": 0, "maximum": 100 }, "risk": { "type": "string", "enum": ["low", "medium", "high"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "reasoning": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } },
          "required": ["score", "risk", "confidence", "reasoning", "evidence"]
        }
      },
      "required": ["customer_satisfaction", "escalation_risk", "resolution_status", "agent_empathy", "business_impact", "repeat_contact"]
    },
    "moments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": { "id": { "type": "integer" }, "type": { "type": "string", "enum": ["escalation", "frustration", "empathy", "business_impact", "resolution"] }, "speaker": { "type": "string", "enum": ["customer", "agent", "other"] }, "evidence": { "type": "string" }, "why_it_matters": { "type": "string" }, "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } },
        "required": ["id", "type", "speaker", "evidence", "why_it_matters", "sentiment", "confidence"]
      }
    },
    "sentiment_recovery": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "opening": { "type": "object", "additionalProperties": false, "properties": { "label": { "type": "string", "enum": ["positive", "neutral", "negative"] }, "score": { "type": "number", "minimum": -100, "maximum": 100 }, "evidence": { "type": "array", "items": { "type": "string" } } }, "required": ["label", "score", "evidence"] },
        "closing": { "type": "object", "additionalProperties": false, "properties": { "label": { "type": "string", "enum": ["positive", "neutral", "negative"] }, "score": { "type": "number", "minimum": -100, "maximum": 100 }, "evidence": { "type": "array", "items": { "type": "string" } } }, "required": ["label", "score", "evidence"] },
        "delta": { "type": "number", "minimum": -200, "maximum": 200 },
        "trend": { "type": "string", "enum": ["improved", "stable", "deteriorated"] },
        "explanation": { "type": "string" }
      },
      "required": ["opening", "closing", "delta", "trend", "explanation"]
    },
    "emotion_distribution": {
      "type": "object", "additionalProperties": false,
      "properties": { "anger": { "type": "number", "minimum": 0, "maximum": 100 }, "frustration": { "type": "number", "minimum": 0, "maximum": 100 }, "disappointment": { "type": "number", "minimum": 0, "maximum": 100 }, "anxiety": { "type": "number", "minimum": 0, "maximum": 100 }, "neutral": { "type": "number", "minimum": 0, "maximum": 100 }, "satisfaction": { "type": "number", "minimum": 0, "maximum": 100 }, "relief": { "type": "number", "minimum": 0, "maximum": 100 }, "gratitude": { "type": "number", "minimum": 0, "maximum": 100 } },
      "required": ["anger", "frustration", "disappointment", "anxiety", "neutral", "satisfaction", "relief", "gratitude"]
    }
  },
  "required": ["overview", "overall_sentiment", "sentences", "kpis", "moments", "sentiment_recovery", "emotion_distribution"]
}
